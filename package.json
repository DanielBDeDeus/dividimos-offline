{
  "name": "dividimos-offline",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:api": "node --test server/*.test.cjs",
    "demo:api": "node scripts/demo-api.cjs",
    "desktop": "npm run build && electron .",
    "dist:linux": "npm run build && electron-builder --linux AppImage --x64 --publish never",
    "dist:win": "npm run build && electron-builder --win portable --x64 --publish never",
    "verify": "npm test && npm run test:api && npm run build && npm run demo:api"
  },
  "dependencies": {
    "lucide-react": "^1.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-grid-layout": "^2.2.3",
    "react-resizable": "^3.1.3",
    "react-router-dom": "^7.14.1",
    "recharts": "^3.8.1",
    "material-symbols": "0.48.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "vite": "^8.0.4",
    "vitest": "^4.1.4",
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "productName": "DividimOS",
  "description": "DividimOS offline desktop, DevOps final project",
  "main": "desktop/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/DanielBDeDeus/dividimos-offline.git"
  }
}
